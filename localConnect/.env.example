# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/localconnect
MONGO_URI_TEST=mongodb://localhost:27017/localconnect_test

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Cache TTL (seconds)
CACHE_TTL_COMMUNITY=300
CACHE_TTL_FEED=120
CACHE_TTL_POPULAR_POSTS=180

